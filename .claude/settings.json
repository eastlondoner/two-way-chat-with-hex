{
  "extraKnownMarketplaces": {
    "vibe-plugins": {
      "source": {
        "source": "github",
        "repo": "eastlondoner/vibe-plugins"
      }
    }
  },
  "enabledPlugins": {
    "vibe-skills@vibe-plugins": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".githooks/post-checkout 0000000000000000000000000000000000000000 $(git rev-parse HEAD) 1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/plugins/ralph-journal/hooks/stop-hook.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/plugins/ralph-journal/hooks/pre-compact.sh"
          }
        ]
      }
    ]
  }
}
