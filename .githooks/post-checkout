#!/bin/bash
# Post-checkout hook: Pull Claude credentials from GitHub variable
# This runs after `git clone` and `git checkout`

# Source portability helpers (with inline fallback for standalone use)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORTABLE_LIB="$SCRIPT_DIR/../.claude/plugins/ralph-journal/scripts/lib/portable.sh"
if [[ -f "$PORTABLE_LIB" ]]; then
  source "$PORTABLE_LIB"
else
  _PORTABLE_OS="$(uname -s)"
  b64_decode() { [[ "$_PORTABLE_OS" == "Darwin" ]] && base64 -D || base64 -d; }
  portable_date_iso() { date -Iseconds 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%S+00:00"; }
fi

# Ensure ~/.claude directory exists
mkdir -p "${HOME}/.claude"

# Logging setup
LOG_DIR="${HOME}/.claude/logs"
LOG_FILE="${LOG_DIR}/post-checkout.log"
mkdir -p "$LOG_DIR"

log() {
    local timestamp=$(portable_date_iso)
    echo "[$timestamp] $1" | tee -a "$LOG_FILE"
}

# Log start and capture exit status
log "=== post-checkout hook started ==="
log "Args: prev_HEAD=$1 new_HEAD=$2 branch_checkout=$3"

cleanup() {
    local exit_code=$?
    if [ $exit_code -eq 0 ]; then
        log "=== post-checkout hook completed successfully ==="
    else
        log "=== post-checkout hook failed with exit code $exit_code ==="
    fi
}
trap cleanup EXIT

set -e

# Only run on branch checkout (not file checkout)
# $3 is 1 for branch checkout, 0 for file checkout
if [ "$3" != "1" ]; then
    log "Skipping: not a branch checkout (file checkout)"
    exit 0
fi

# Install gh CLI on Linux if not available
# Required: gh provides git credential authentication via `gh auth setup-git`
if [[ "$(uname -s)" == "Linux" ]] && ! command -v gh &> /dev/null; then
    log "Installing GitHub CLI (required for git credential auth on Linux)..."
    GH_VERSION=$(curl -s https://api.github.com/repos/cli/cli/releases/latest | jq -r '.tag_name' | sed 's/^v//')
    if [ -n "$GH_VERSION" ] && [ "$GH_VERSION" != "null" ]; then
        # Download and extract - track success before attempting install
        if curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" -o /tmp/gh.tar.gz && \
           tar -xzf /tmp/gh.tar.gz -C /tmp; then
            # Try to install to /usr/local/bin (works if root or writable), otherwise add to PATH
            if mv /tmp/gh_${GH_VERSION}_linux_amd64/bin/gh /usr/local/bin/ 2>/dev/null; then
                rm -rf /tmp/gh.tar.gz /tmp/gh_${GH_VERSION}_linux_amd64
                log "GitHub CLI v${GH_VERSION} installed to /usr/local/bin"
            else
                # Fallback: keep in /tmp and add to PATH
                rm -f /tmp/gh.tar.gz  # Clean up tarball
                export PATH="/tmp/gh_${GH_VERSION}_linux_amd64/bin:$PATH"
                # Only add to bashrc if not already present (idempotency)
                if ! grep -q "gh_.*_linux_amd64/bin" ~/.bashrc 2>/dev/null; then
                    echo "export PATH=\"/tmp/gh_${GH_VERSION}_linux_amd64/bin:\$PATH\"" >> ~/.bashrc
                fi
                log "GitHub CLI v${GH_VERSION} added to PATH (kept in /tmp)"
            fi
        else
            log "Failed to download or extract GitHub CLI, continuing without gh"
            rm -f /tmp/gh.tar.gz  # Clean up any partial download
        fi
    else
        log "Could not determine gh version, continuing without gh"
    fi
elif command -v gh &> /dev/null; then
    log "GitHub CLI already installed: $(gh --version | head -1)"
fi

# Install OpenSSH client on Linux if not available
# Required: ssh is needed for desktop access via HTTP relay
if [[ "$(uname -s)" == "Linux" ]] && ! command -v ssh &> /dev/null; then
    log "Installing OpenSSH client (required for desktop SSH access)..."
    if command -v apt-get &> /dev/null; then
        # Debian/Ubuntu
        if apt-get update -qq && apt-get install -y -qq openssh-client > /dev/null 2>&1; then
            log "OpenSSH client installed via apt-get: $(ssh -V 2>&1)"
        else
            log "Failed to install OpenSSH client via apt-get"
        fi
    elif command -v apk &> /dev/null; then
        # Alpine Linux
        if apk add --quiet openssh-client > /dev/null 2>&1; then
            log "OpenSSH client installed via apk: $(ssh -V 2>&1)"
        else
            log "Failed to install OpenSSH client via apk"
        fi
    elif command -v yum &> /dev/null; then
        # RHEL/CentOS
        if yum install -y -q openssh-clients > /dev/null 2>&1; then
            log "OpenSSH client installed via yum: $(ssh -V 2>&1)"
        else
            log "Failed to install OpenSSH client via yum"
        fi
    else
        log "No supported package manager found, cannot install OpenSSH client"
    fi
elif command -v ssh &> /dev/null; then
    log "OpenSSH client already installed: $(ssh -V 2>&1)"
fi

# Check if GITHUB_TOKEN is available
if [ -z "$GITHUB_TOKEN" ]; then
    log "No GITHUB_TOKEN found, skipping credential sync"
    exit 0
fi

# Get repo info from git remote
REPO_URL=$(git remote get-url origin 2>/dev/null || echo "")
if [ -z "$REPO_URL" ]; then
    log "No git remote origin found, skipping"
    exit 0
fi
log "Remote URL: $REPO_URL"

# Extract owner/repo from URL (handles HTTPS, SSH, and local proxy URLs)
# Patterns:
#   - github.com:owner/repo or github.com/owner/repo
#   - local proxy: http://...127.0.0.1:.../git/owner/repo
if echo "$REPO_URL" | grep -q 'github\.com'; then
    REPO=$(echo "$REPO_URL" | sed -E 's|.*github\.com[:/](.+)(\.git)?$|\1|' | sed 's/\.git$//')
elif echo "$REPO_URL" | grep -qE '/git/[^/]+/[^/]+$'; then
    REPO=$(echo "$REPO_URL" | sed -E 's|.*/git/([^/]+/[^/]+)$|\1|')
else
    REPO=""
fi

if [ -z "$REPO" ]; then
    log "Could not extract repo from URL, skipping"
    exit 0
fi
log "Repository: $REPO"

log "Fetching credentials from GitHub variable..."

# Fetch credentials from GitHub variable
RESPONSE=$(curl -s -H "Authorization: token $GITHUB_TOKEN" \
    -H "Accept: application/vnd.github.v3+json" \
    "https://api.github.com/repos/$REPO/actions/variables/CLAUDE_CREDENTIALS" 2>/dev/null || echo "")

if [ -z "$RESPONSE" ] || echo "$RESPONSE" | grep -q '"message"'; then
    log "No credentials found in GitHub variable (or API error), skipping"
    log "Response: $RESPONSE"
    exit 0
fi

# Extract and decode the value
VALUE=$(echo "$RESPONSE" | jq -r '.value // empty' 2>/dev/null)

if [ -z "$VALUE" ]; then
    log "Could not parse credentials from response, skipping"
    exit 0
fi

# Write credentials to Claude config
mkdir -p ~/.claude
echo "$VALUE" | b64_decode > ~/.claude/.credentials.json
chmod 600 ~/.claude/.credentials.json

log "Credentials restored successfully to ~/.claude/.credentials.json"

# Fetch and setup SSH key for desktop access
setup_ssh_desktop_key() {
    log "Fetching SSH key from GitHub variable..."

    SSH_RESPONSE=$(curl -s -H "Authorization: token $GITHUB_TOKEN" \
        -H "Accept: application/vnd.github.v3+json" \
        "https://api.github.com/repos/$REPO/actions/variables/CLAUDE_SSH_KEY" 2>/dev/null || echo "")

    if [ -z "$SSH_RESPONSE" ] || echo "$SSH_RESPONSE" | grep -q '"message"'; then
        log "No SSH key found in GitHub variable (or API error), skipping"
        return 0
    fi

    SSH_KEY_B64=$(echo "$SSH_RESPONSE" | jq -r '.value // empty' 2>/dev/null)

    if [ -z "$SSH_KEY_B64" ]; then
        log "Could not parse SSH key from response, skipping"
        return 0
    fi

    # Setup SSH directory and key
    mkdir -p ~/.ssh
    chmod 700 ~/.ssh

    echo "$SSH_KEY_B64" | b64_decode > ~/.ssh/claude_desktop_key
    chmod 600 ~/.ssh/claude_desktop_key

    # Fetch desktop host and user from GitHub variables
    DESKTOP_HOST_RESPONSE=$(curl -s -H "Authorization: token $GITHUB_TOKEN" \
        -H "Accept: application/vnd.github.v3+json" \
        "https://api.github.com/repos/$REPO/actions/variables/CLAUDE_DESKTOP_HOST" 2>/dev/null || echo "")
    DESKTOP_HOST=$(echo "$DESKTOP_HOST_RESPONSE" | jq -r '.value // empty' 2>/dev/null)

    DESKTOP_USER_RESPONSE=$(curl -s -H "Authorization: token $GITHUB_TOKEN" \
        -H "Accept: application/vnd.github.v3+json" \
        "https://api.github.com/repos/$REPO/actions/variables/CLAUDE_DESKTOP_USER" 2>/dev/null || echo "")
    DESKTOP_USER=$(echo "$DESKTOP_USER_RESPONSE" | jq -r '.value // empty' 2>/dev/null)

    # Fetch SSH relay URL from GitHub variable (for sandboxed environments)
    RELAY_URL_RESPONSE=$(curl -s -H "Authorization: token $GITHUB_TOKEN" \
        -H "Accept: application/vnd.github.v3+json" \
        "https://api.github.com/repos/$REPO/actions/variables/CLAUDE_SSH_RELAY_URL" 2>/dev/null || echo "")
    RELAY_URL=$(echo "$RELAY_URL_RESPONSE" | jq -r '.value // empty' 2>/dev/null)

    # Fetch SSH relay API key from GitHub variable (for DoS prevention)
    RELAY_API_KEY_RESPONSE=$(curl -s -H "Authorization: token $GITHUB_TOKEN" \
        -H "Accept: application/vnd.github.v3+json" \
        "https://api.github.com/repos/$REPO/actions/variables/CLAUDE_SSH_RELAY_API_KEY" 2>/dev/null || echo "")
    RELAY_API_KEY=$(echo "$RELAY_API_KEY_RESPONSE" | jq -r '.value // empty' 2>/dev/null)

    # Copy the relay script to ~/.ssh if it exists
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [ -f "$SCRIPT_DIR/ssh_http_relay.py" ]; then
        cp "$SCRIPT_DIR/ssh_http_relay.py" ~/.ssh/ssh_http_relay.py
        chmod +x ~/.ssh/ssh_http_relay.py
        log "Copied ssh_http_relay.py to ~/.ssh/"
    fi

    # Add to SSH config if not already present
    if [ ! -f ~/.ssh/config ] || ! grep -q "IdentityFile.*claude_desktop_key" ~/.ssh/config; then
        if [ -n "$DESKTOP_HOST" ] && [ -n "$DESKTOP_USER" ]; then
            # Check if we need HTTP relay (sandboxed environment with relay URL configured)
            if [ -n "$RELAY_URL" ] && [ "$CLAUDE_CODE_REMOTE" = "true" ]; then
                # Build ProxyCommand with optional API key
                if [ -n "$RELAY_API_KEY" ]; then
                    PROXY_CMD="python3 ~/.ssh/ssh_http_relay.py ${RELAY_URL} ${RELAY_API_KEY}"
                else
                    PROXY_CMD="python3 ~/.ssh/ssh_http_relay.py ${RELAY_URL}"
                fi

                cat >> ~/.ssh/config << SSHCONFIG

# Claude desktop access via HTTP relay (for sandboxed environments)
Host desktop
    HostName localhost
    User ${DESKTOP_USER}
    IdentityFile ~/.ssh/claude_desktop_key
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    ProxyCommand ${PROXY_CMD}
SSHCONFIG
                log "Added desktop SSH config with HTTP relay (relay: $RELAY_URL, user: $DESKTOP_USER)"
            else
                cat >> ~/.ssh/config << SSHCONFIG

# Claude desktop access key
Host desktop
    HostName ${DESKTOP_HOST}
    User ${DESKTOP_USER}
    IdentityFile ~/.ssh/claude_desktop_key
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts
SSHCONFIG
                log "Added desktop SSH config (host: $DESKTOP_HOST, user: $DESKTOP_USER)"
            fi
        else
            cat >> ~/.ssh/config << 'SSHCONFIG'

# Claude desktop access key
Host desktop
    IdentityFile ~/.ssh/claude_desktop_key
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts
SSHCONFIG
            log "Added desktop SSH config (no host/user configured)"
        fi
        chmod 600 ~/.ssh/config
    fi

    log "SSH key restored successfully to ~/.ssh/claude_desktop_key"
}

setup_ssh_desktop_key

# Configure Claude Code local state to skip onboarding dialogs
CLAUDE_JSON="${HOME}/.claude.json"
PROJECT_DIR=$(pwd)

configure_claude_state() {
    log "Configuring Claude Code local state..."

    # Create ~/.claude.json if it doesn't exist
    if [ ! -f "$CLAUDE_JSON" ]; then
        echo '{}' > "$CLAUDE_JSON"
        log "Created new ~/.claude.json"
    fi

    # Set hasCompletedOnboarding if not already set
    if ! jq -e '.hasCompletedOnboarding' "$CLAUDE_JSON" > /dev/null 2>&1; then
        jq '.hasCompletedOnboarding = true' "$CLAUDE_JSON" > "${CLAUDE_JSON}.tmp" && mv "${CLAUDE_JSON}.tmp" "$CLAUDE_JSON"
        log "Set hasCompletedOnboarding = true"
    else
        log "hasCompletedOnboarding already set"
    fi

    # Set theme if not already set
    if ! jq -e '.theme' "$CLAUDE_JSON" > /dev/null 2>&1; then
        jq '.theme = "dark"' "$CLAUDE_JSON" > "${CLAUDE_JSON}.tmp" && mv "${CLAUDE_JSON}.tmp" "$CLAUDE_JSON"
        log "Set theme = dark"
    else
        log "theme already set"
    fi

    # Set bypassPermissionsModeAccepted to skip the bypass dialog in sandboxed environments
    if ! jq -e '.bypassPermissionsModeAccepted' "$CLAUDE_JSON" > /dev/null 2>&1; then
        jq '.bypassPermissionsModeAccepted = true' "$CLAUDE_JSON" > "${CLAUDE_JSON}.tmp" && mv "${CLAUDE_JSON}.tmp" "$CLAUDE_JSON"
        log "Set bypassPermissionsModeAccepted = true"
    else
        log "bypassPermissionsModeAccepted already set"
    fi

    # Initialize projects object if it doesn't exist
    if ! jq -e '.projects' "$CLAUDE_JSON" > /dev/null 2>&1; then
        jq '.projects = {}' "$CLAUDE_JSON" > "${CLAUDE_JSON}.tmp" && mv "${CLAUDE_JSON}.tmp" "$CLAUDE_JSON"
        log "Initialized projects object"
    fi

    # Initialize project entry if it doesn't exist
    if ! jq -e ".projects[\"$PROJECT_DIR\"]" "$CLAUDE_JSON" > /dev/null 2>&1; then
        jq ".projects[\"$PROJECT_DIR\"] = {}" "$CLAUDE_JSON" > "${CLAUDE_JSON}.tmp" && mv "${CLAUDE_JSON}.tmp" "$CLAUDE_JSON"
        log "Initialized project entry for $PROJECT_DIR"
    fi

    # Set hasTrustDialogAccepted for this project
    if ! jq -e ".projects[\"$PROJECT_DIR\"].hasTrustDialogAccepted" "$CLAUDE_JSON" > /dev/null 2>&1 || \
       [ "$(jq -r ".projects[\"$PROJECT_DIR\"].hasTrustDialogAccepted" "$CLAUDE_JSON")" != "true" ]; then
        jq ".projects[\"$PROJECT_DIR\"].hasTrustDialogAccepted = true" "$CLAUDE_JSON" > "${CLAUDE_JSON}.tmp" && mv "${CLAUDE_JSON}.tmp" "$CLAUDE_JSON"
        log "Set hasTrustDialogAccepted = true for $PROJECT_DIR"
    else
        log "hasTrustDialogAccepted already set for $PROJECT_DIR"
    fi

    # Auto-enable MCP servers from .mcp.json if it exists
    MCP_JSON="${PROJECT_DIR}/.mcp.json"
    if [ -f "$MCP_JSON" ]; then
        log "Found .mcp.json, auto-enabling MCP servers..."

        # Get list of MCP server names from .mcp.json
        MCP_SERVERS=$(jq -r '.mcpServers | keys[]' "$MCP_JSON" 2>/dev/null || echo "")

        if [ -n "$MCP_SERVERS" ]; then
            # Build JSON array of server names
            SERVERS_ARRAY=$(echo "$MCP_SERVERS" | jq -R -s 'split("\n") | map(select(length > 0))')

            # Merge with existing enabledMcpjsonServers (avoiding duplicates)
            EXISTING=$(jq -r ".projects[\"$PROJECT_DIR\"].enabledMcpjsonServers // []" "$CLAUDE_JSON")
            MERGED=$(echo "[$EXISTING, $SERVERS_ARRAY]" | jq -s 'add | flatten | unique')

            jq ".projects[\"$PROJECT_DIR\"].enabledMcpjsonServers = $MERGED" "$CLAUDE_JSON" > "${CLAUDE_JSON}.tmp" && mv "${CLAUDE_JSON}.tmp" "$CLAUDE_JSON"
            log "Enabled MCP servers: $(echo $MCP_SERVERS | tr '\n' ' ')"
        else
            log "No MCP servers found in .mcp.json"
        fi
    else
        log "No .mcp.json found in project"
    fi

    log "Claude Code local state configured successfully"
}

# Run the configuration
configure_claude_state

# Pre-start local Claude TUI session in remote environments
start_local_claude_session() {
    # Only start in remote Claude Code environments
    if [ "$CLAUDE_CODE_REMOTE" != "true" ]; then
        log "Not in remote environment, skipping local Claude session start"
        return 0
    fi

    # Check if session already exists
    if tmux has-session -t claude-local 2>/dev/null; then
        log "Local Claude session already exists"
        return 0
    fi

    log "Starting local Claude TUI session..."
    tmux new-session -d -s claude-local "bash -c 'unset CLAUDE_CODE_REMOTE CLAUDE_CODE_ENTRYPOINT CLAUDECODE CLAUDE_CODE_SESSION_ID CLAUDE_CODE_REMOTE_SESSION_ID CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR CLAUDE_CODE_WEBSOCKET_AUTH_FILE_DESCRIPTOR; export IS_SANDBOX=1; exec claude --dangerously-skip-permissions'"

    if tmux has-session -t claude-local 2>/dev/null; then
        log "Local Claude session started successfully"
    else
        log "Failed to start local Claude session"
    fi
}

start_local_claude_session
