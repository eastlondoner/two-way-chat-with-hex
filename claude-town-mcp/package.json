{
  "name": "claude-town-mcp",
  "version": "0.1.4",
  "description": "MCP server for orchestrating Claude Code web sessions",
  "type": "module",
  "bin": {
    "claude-town-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eastlondoner/claude.git",
    "directory": "claude-town-mcp"
  },
  "homepage": "https://github.com/eastlondoner/claude/tree/main/claude-town-mcp#readme",
  "bugs": {
    "url": "https://github.com/eastlondoner/claude/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "eastlondoner",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "ai",
    "llm",
    "orchestration"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outfile=dist/index.js --target=node --minify",
    "start": "node dist/index.js",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check": "bun run typecheck && bun run lint",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
